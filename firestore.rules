rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function namedOwner(data) { return signedIn() && data.get('userId', '') == request.auth.uid; }
    // Legacy UID-prefixed records remain readable, but an explicit different owner wins.
    function ownsLegacy(id, data) {
      return namedOwner(data) || (signedIn() && data.get('userId', request.auth.uid) == request.auth.uid && id.matches(request.auth.uid + '_.*'));
    }
    function readsLegacy(id) {
      return signedIn() && ((resource == null && id.matches(request.auth.uid + '_.*')) || ownsLegacy(id, resource.data));
    }
    function recoveryWritesAllowed() {
      let setupPath = /databases/$(database)/documents/onboarding/$(request.auth.uid);
      let setup = exists(setupPath) ? get(setupPath).data : {};
      let runId = setup.get('revampRunId', '');
      return setup.get('revampArchivePending', null) == null &&
        (runId == '' || get(/databases/$(database)/documents/users/$(request.auth.uid)/revampHistory/$(runId)).data.complete == true);
    }
    function onboardingFields() {
      return ['name', 'businessName', 'websiteUrl', 'businessType', 'customBusinessType',
        'businessLocation', 'servesMultipleCities', 'serviceCities', 'cmsPlatform',
        'hasGSC', 'gscProperty', 'googleEmail', 'isComplete', 'privacyPolicyAccepted',
        'postOnboardingStep', 'pagesStepCompleted', 'revampReminderDate'];
    }
    function safeInitialOnboarding() {
      let data = request.resource.data;
      return data.keys().hasOnly(onboardingFields().concat([
          'siteCrawlStatus', 'lastSiteCrawlAt', 'revampStatus', 'revampDate',
          'revampInitiatedAt', 'revampPages', 'revampStep'])) &&
        data.get('siteCrawlStatus', 'idle') == 'idle' && data.get('lastSiteCrawlAt', null) == null &&
        data.get('revampStatus', 'idle') == 'idle' && data.get('revampDate', null) == null &&
        data.get('revampInitiatedAt', null) == null && data.get('revampPages', []) == [] && data.get('revampStep', null) == null;
    }
    match /onboarding/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid) && safeInitialOnboarding();
      // Only editable profile/preferences/navigation fields. Monitoring and recovery state are server-owned.
      allow update: if owner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(onboardingFields());
      allow delete: if false; // Do not allow delete/recreate to remove recovery safeguards.
    }

    match /users/{uid} {
      // Existing Google API clients still read this owner-only document. Token writes now use authenticated APIs.
      allow read: if owner(uid);
      allow write: if false;
      match /feedbackPrompt/{id} { allow read, write: if owner(uid); }
      match /revampHistory/{history=**} { allow read, write: if false; }
    }
    match /gscTokens/{uid} { allow read: if owner(uid); allow write: if false; }
      
    // Authoritative observations/outcomes are added by server code. Historical client
    // snapshots (preStats/postStats) are retained for compatibility and never trusted as measurements.
    function trustedOutcomeFields() { return ['progressAssessment']; }
    function credentialFields() { return ['gscToken', 'accessToken', 'refreshToken', 'gscAccessToken', 'gscRefreshToken']; }
    function credentialUnchangedOrRemoved(key) {
      return !(key in request.resource.data) || (key in resource.data && request.resource.data[key] == resource.data[key]);
    }
    function safeSeoCreate(id) {
      return namedOwner(request.resource.data) && id.matches(request.auth.uid + '_.*') && recoveryWritesAllowed() &&
        !request.resource.data.keys().hasAny(trustedOutcomeFields()) && !request.resource.data.keys().hasAny(credentialFields());
    }
    function safeSeoUpdate(id) {
      return ownsLegacy(id, resource.data) && namedOwner(request.resource.data) && recoveryWritesAllowed() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(trustedOutcomeFields()) &&
        credentialUnchangedOrRemoved('gscToken') && credentialUnchangedOrRemoved('accessToken') &&
        credentialUnchangedOrRemoved('refreshToken') && credentialUnchangedOrRemoved('gscAccessToken') && credentialUnchangedOrRemoved('gscRefreshToken');
    }
    match /implementedSeoTips/{id} {
      allow read: if readsLegacy(id);
      allow create: if safeSeoCreate(id);
      allow update: if safeSeoUpdate(id);
      allow delete: if false;
    }
    match /contentAuditResults/{id} {
      allow read: if readsLegacy(id);
      allow create: if safeSeoCreate(id);
      allow update: if safeSeoUpdate(id);
      allow delete: if false;
    }
    match /aiSuggestions/{id} {
      allow read: if readsLegacy(id);
      allow create: if safeSeoCreate(id);
      allow update: if safeSeoUpdate(id);
      allow delete: if false;
    }

    function safeCacheCreate(id) {
      return signedIn() && id.matches(request.auth.uid + '_.*') &&
        request.resource.data.get('userId', request.auth.uid) == request.auth.uid;
    }
    function safeCacheUpdate(id) {
      return ownsLegacy(id, resource.data) &&
        request.resource.data.get('userId', request.auth.uid) == request.auth.uid;
    }
    match /internalLinkSuggestions/{id} {
      allow read: if readsLegacy(id);
      allow delete: if ownsLegacy(id, resource.data);
      allow create: if safeCacheCreate(id);
      allow update: if safeCacheUpdate(id);
    }
    match /pageContentCache/{id} {
      allow read: if owner(id) || readsLegacy(id);
      allow create: if safeCacheCreate(id);
      allow update: if safeCacheUpdate(id);
      allow delete: if ownsLegacy(id, resource.data);
      match /pages/{page} {
        allow read, delete: if owner(id);
        allow create, update: if owner(id) && request.resource.data.get('userId', id) == id;
      }
    }
    match /intentMismatches/{id} {
      allow read: if owner(id) || readsLegacy(id);
      allow create: if safeCacheCreate(id);
      allow update: if safeCacheUpdate(id);
      allow delete: if ownsLegacy(id, resource.data);
      match /analyses/{analysis} {
        allow read, delete: if owner(id);
        allow create, update: if owner(id) && request.resource.data.get('userId', id) == id;
      }
    }
    
    // Ownerless flat URL-keyed meta caches cannot be safely attributed. Deny them;
    // authenticated regeneration uses a UID-scoped cache instead.
    match /seoMetaTitles/{id} {
      allow read, delete: if namedOwner(resource.data);
      allow create: if false;
      allow update: if namedOwner(resource.data) && namedOwner(request.resource.data);
      match /titles/{key} {
        allow read, delete: if owner(id);
        allow create, update: if owner(id) && request.resource.data.get('userId', id) == id;
      }
    }
    match /seoMetaDescriptions/{id} {
      allow read, delete: if namedOwner(resource.data);
      allow create: if false;
      allow update: if namedOwner(resource.data) && namedOwner(request.resource.data);
      match /descriptions/{key} {
        allow read, delete: if owner(id);
        allow create, update: if owner(id) && request.resource.data.get('userId', id) == id;
      }
    }
    
    // These collections are managed by authenticated server APIs. There is no
    // generic users/{uid}/** grant: history and future private subcollections stay denied.
    match /focusKeywords/{path=**} { allow read, write: if false; }
    match /siteCrawls/{path=**} { allow read, write: if false; }
    match /contentKeywordEdits/{path=**} { allow read, write: if false; }
    match /conversations/{path=**} { allow read, write: if false; }
    match /gscOAuthStates/{path=**} { allow read, write: if false; }
    match /progressJobs/{path=**} { allow read, write: if false; }
    match /requestLimits/{path=**} { allow read, write: if false; }
    match /genericKeywordsCache/{path=**} { allow read, write: if false; }
    match /skippedKeywords/{path=**} { allow read, write: if false; }
    match /createdContentOpportunities/{path=**} { allow read, write: if false; }
    match /trainingEvents/{path=**} { allow read, write: if false; }
    match /playbookStrategies/{path=**} { allow read, write: if false; }
    match /conversationSummaries/{path=**} { allow read, write: if false; }
    match /appConfig/{path=**} { allow read, write: if false; }
    match /accessRequests/{path=**} { allow read, write: if false; }
    match /approvedUsers/{path=**} { allow read, write: if false; }
    match /invitationCodes/{path=**} { allow read, write: if false; }
    match /contactMessages/{path=**} { allow read, write: if false; }
    match /deletedUsers/{path=**} { allow read, write: if false; }
    match /{path=**} { allow read, write: if false; }
  }
}
